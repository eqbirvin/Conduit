<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_SENSITIVE_NOTIFICATIONS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- ShizukuPlus drop-in builds before r2760 shift every binder call by one for apps that only
         declare Shizuku's original API_V23 permission (added by the Shizuku provider library).
         Declaring ShizukuPlus's own permission opts out of that. Ignored by official Shizuku. -->
    <uses-permission android:name="af.shizuku.plus.permission.API_V23" />

    <!-- Requires this permission if the app wants to read its own notifications. But NotificationListenerService needs BIND_NOTIFICATION_LISTENER_SERVICE on the service itself -->

    <queries>
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.readdle.spark" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.android.dialer" />
        <package android:name="com.samsung.android.dialer" />
        <package android:name="com.android.phone" />
        <package android:name="com.android.server.telecom" />
        <package android:name="com.android.contacts" />
        <package android:name="com.google.android.apps.tycho" />
        <package android:name="com.google.android.keep" />
        <package android:name="notion.id" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.google.android.apps.recorder" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.valvesoftware.android.steam.community" />
        <package android:name="com.valvesoftware.steamchat" />
        <package android:name="com.valvesoftware.android.steam.friendsui" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.twitter.android" />
        <package android:name="com.microsoft.teams" />
        <package android:name="com.airbnb.android" />
        <package android:name="com.blackberry.hub" />
        <package android:name="com.microsoft.office.outlook" />
        <package android:name="net.thunderbird.android" />
        <package android:name="net.thunderbird.android.beta" />
        <package android:name="eu.faircode.email" />
        <package android:name="com.fsck.k9" />
        <package android:name="com.easilydo.mail" />
        <package android:name="ch.protonmail.android" />
        <package android:name="com.yahoo.mobile.client.android.mail" />
        <package android:name="com.yahoo.mobile.client.android.mail.go" />
        <package android:name="com.pingapp.app" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.beeper.chat" />
        <package android:name="com.beeper.ima" />
        <package android:name="com.beeper.android" />
        <package android:name="com.textra" />
        <package android:name="com.discord" />
        <package android:name="com.discord.canary" />
        <package android:name="com.Slack" />
        <package android:name="com.google.android.apps.dynamite" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="com.google.android.apps.tachyon" />
        <package android:name="com.google.android.apps.meetings" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.viber.voip" />
        <package android:name="com.groupme.android" />
        <package android:name="com.skype.raider" />
        <package android:name="com.skype.m2" />
        <package android:name="com.bluebubbles.messaging" />
        <package android:name="me.tagavari.airmessage" />
        <package android:name="com.rebelvox.voxer" />
        <package android:name="com.loudtalks" />
        <package android:name="net.loudtalks" />
        <package android:name="xyz.klinker.messenger" />
        <package android:name="com.p1.chompsms" />
        <package android:name="com.moez.QKSMS" />
        <package android:name="dev.octoshrimpy.quik" />
        <package android:name="dev.octoshrimpy.quik.fdroid" />
        <package android:name="com.anindra.messages" />
        <package android:name="com.simplemobiletools.smsmessenger" />
        <package android:name="org.fossify.messages" />
        <package android:name="com.calea.echo" />
        <package android:name="rpkandrodev.yaata" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.zhiliaoapp.musically.go" />
        <package android:name="tv.twitch.android.viewer" />
        <package android:name="tv.twitch.android.app" />
        
        <!-- Clock & Timer Packages -->
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.oneplus.deskclock" />
        <package android:name="com.coloros.alarmclock" />
        <package android:name="com.oppo.alarmclock" />
        <package android:name="com.miui.deskclock" />
        <package android:name="com.asus.deskclock" />
        <package android:name="com.motorola.blur.alarmclock" />
