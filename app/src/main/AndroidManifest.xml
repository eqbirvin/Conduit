<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_SENSITIVE_NOTIFICATIONS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Requires this permission if the app wants to read its own notifications. But NotificationListenerService needs BIND_NOTIFICATION_LISTENER_SERVICE on the service itself -->

    <queries>
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.readdle.spark" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.android.dialer" />
        <package android:name="com.samsung.android.dialer" />
        <package android:name="com.android.phone" />
        <package android:name="com.android.server.telecom" />
        <package android:name="com.android.contacts" />
        <package android:name="com.google.android.apps.tycho" />
        <package android:name="com.google.android.keep" />
        <package android:name="notion.id" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.google.android.apps.recorder" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.valvesoftware.android.steam.community" />
        <package android:name="com.valvesoftware.steamchat" />
        <package android:name="com.valvesoftware.android.steam.friendsui" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.twitter.android" />
        <package android:name="com.microsoft.teams" />
        <package android:name="com.airbnb.android" />
        <package android:name="com.blackberry.hub" />
        <package android:name="com.microsoft.office.outlook" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.beeper.chat" />
        <package android:name="com.beeper.ima" />
        <package android:name="com.textra" />
        <package android:name="com.discord" />
        <package android:name="com.discord.canary" />
        <package android:name="com.Slack" />
        <package android:name="com.google.android.apps.dynamite" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="com.google.android.apps.tachyon" />
        <package android:name="com.google.android.apps.meetings" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.viber.voip" />
        <package android:name="com.groupme.android" />
        <package android:name="com.skype.raider" />
        <package android:name="com.skype.m2" />
        <package android:name="com.bluebubbles.messaging" />
        <package android:name="me.tagavari.airmessage" />
        <package android:name="xyz.klinker.messenger" />
        <package android:name="com.p1.chompsms" />
        <package android:name="com.moez.QKSMS" />
        <package android:name="com.simplemobiletools.smsmessenger" />
        <package android:name="org.fossify.messages" />
        <package android:name="com.calea.echo" />
        <package android:name="rpkandrodev.yaata" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.zhiliaoapp.musically.go" />
        <package android:name="tv.twitch.android.viewer" />
    </queries>

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher_manila"
        android:roundIcon="@mipmap/ic_launcher_manila_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Conduit"
        tools:targetApi="31">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Conduit"
            android:allowEmbedded="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
        </activity>

        <activity-alias
            android:name=".MainActivityLegacy"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityManila"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_manila"
            android:roundIcon="@mipmap/ic_launcher_manila_round"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityDark"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_dark"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityBlue"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_blue_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service android:name=".HubNotificationListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".widget.ConduitWidgetProvider"
            android:label="Standard - Conduit"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/conduit_widget_info" />
        </receiver>

        <receiver android:name=".widget.CustomViewWidgetProvider"
            android:label="Custom View - Conduit"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/custom_view_widget_info" />
        </receiver>

        <activity android:name=".widget.CustomViewWidgetConfigureActivity"
            android:theme="@style/Theme.Conduit"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity android:name=".widget.ConduitWidgetClickActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <service android:name=".widget.ConduitWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

    </application>

</manifest>
