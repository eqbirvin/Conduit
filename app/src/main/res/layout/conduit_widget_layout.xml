                android:background="@drawable/widget_badge_bg"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Slot 5 -->
        <FrameLayout
            android:id="@+id/widget_slot_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_slot_icon_5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp" />
            <TextView
                android:id="@+id/widget_slot_badge_5"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/widget_badge_bg"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Slot 6 -->
        <FrameLayout
            android:id="@+id/widget_slot_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_slot_icon_6"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp" />
            <TextView
                android:id="@+id/widget_slot_badge_6"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/widget_badge_bg"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Slot 7 -->
        <FrameLayout
            android:id="@+id/widget_slot_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_slot_icon_7"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp" />
            <TextView
                android:id="@+id/widget_slot_badge_7"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/widget_badge_bg"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
